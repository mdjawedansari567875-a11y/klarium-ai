{
  "expo": {
    "name": "KLARIUM AI",
    "slug": "klarium-ai",
    "owner": "carfam7s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B14",
    "icon": "./assets/klarium-icon.png",
    "splash": {
      "image": "./assets/klarium-splash-icon.png",
      "backgroundColor": "#0B0B14",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carfam.klariumai",
      "infoPlist": {
        "NSCameraUsageDescription": "KLARIUM AI uses the camera so you can take a photo of a question and get it explained.",
        "NSMicrophoneUsageDescription": "KLARIUM AI uses the microphone so you can speak your question instead of typing it.",
        "NSPhotoLibraryUsageDescription": "KLARIUM AI needs access to your photos so you can send a picture of a question."
      }
    },
    "android": {
      "package": "com.carfam.klariumai",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/klarium-adaptive-icon-foreground.png",
        "backgroundColor": "#0B0B14"
      },
      "permissions": ["CAMERA", "RECORD_AUDIO", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "KLARIUM AI needs access to your photos so you can send a picture of a question.",
          "cameraPermission": "KLARIUM AI uses the camera so you can take a photo of a question and get it explained."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "KLARIUM AI uses the microphone so you can speak your question instead of typing it."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4AF37"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "e9bfe1bb-4e36-44bc-92ec-07951cbf2811"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-4588188976164551~1893143462",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
